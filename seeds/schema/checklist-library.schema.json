{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qualitym.local/schema/checklist-library.schema.json",
  "title": "QualityM checklist library",
  "type": "object",
  "required": ["seed_version", "checklists"],
  "additionalProperties": false,
  "properties": {
    "seed_version": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+){1,2}$"},
    "source_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["filename", "sha256"],
        "additionalProperties": false,
        "properties": {
          "filename": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "checklists": {
      "type": "array",
      "items": {"$ref": "#/$defs/checklist"}
    }
  },
  "$defs": {
    "stableKey": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "row": {"type": ["integer", "null"], "minimum": 1},
        "content_cell": {"type": "string", "pattern": "^[A-Z]+[1-9][0-9]*$"},
        "max_row": {"type": "integer", "minimum": 1},
        "max_column": {"type": "integer", "minimum": 1},
        "print_area": {"type": ["string", "null"]},
        "freeze_panes": {"type": ["string", "null"]}
      }
    },
    "issue": {
      "type": "object",
      "required": ["stable_key", "title", "description", "corrective_suggestion", "default_severity"],
      "additionalProperties": false,
      "properties": {
        "stable_key": {"$ref": "#/$defs/stableKey"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "corrective_suggestion": {"type": "string", "minLength": 1},
        "default_severity": {"enum": ["轻微", "一般", "严重"]},
        "placeholders": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "is_default": {"type": "boolean"}
      }
    },
    "item": {
      "type": "object",
      "required": ["stable_key", "content", "issue_templates"],
      "additionalProperties": false,
      "properties": {
        "stable_key": {"$ref": "#/$defs/stableKey"},
        "display_no": {"type": ["string", "integer"]},
        "content": {"type": "string", "minLength": 1},
        "starred": {"type": "boolean"},
        "source": {"$ref": "#/$defs/sourceLocation"},
        "issue_templates": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
      }
    },
    "group": {
      "type": "object",
      "required": ["stable_key", "name", "items"],
      "additionalProperties": false,
      "properties": {
        "stable_key": {"$ref": "#/$defs/stableKey"},
        "name": {"type": "string", "minLength": 1},
        "display_heading": {"type": "boolean"},
        "source": {"$ref": "#/$defs/sourceLocation"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
      }
    },
    "checklist": {
      "type": "object",
      "required": ["stable_key", "name", "audit_kind", "groups"],
      "additionalProperties": false,
      "properties": {
        "stable_key": {"$ref": "#/$defs/stableKey"},
        "name": {"type": "string", "minLength": 1},
        "audit_kind": {"enum": ["product", "process"]},
        "source_workbook": {"type": "string", "minLength": 1},
        "source_sheet": {"type": "string"},
        "source": {"$ref": "#/$defs/sourceLocation"},
        "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}}
      }
    }
  }
}
